# Copy this file to .env.local. Keep all real values out of Git.
# No credentials are required to preview the public design.

# Canonical URL of YOUR running copy, without a trailing slash.
# Change to https://your-domain.example when deploying.
APP_ORIGIN=http://localhost:3000

# Create your own Supabase project, then run supabase/schema.sql.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# UUID of your confirmed Supabase Auth owner user. No default owner exists.
ADMIN_USER_ID=

# Optional: allow provisioned non-admin users to sign in, like and comment.
# Public registration is not implemented. Keep Supabase signup disabled.
ENABLE_COMMUNITY=false
